# Data — never committed. Regenerate with scripts/download_data.py
data/raw/
*.csv
*.zip

# Manifests ARE committed: they are the reproducibility record for a dataset
# we cannot check in. Row counts, SHA-256 digests and null profiles let anyone
# confirm they are working from the same extract.
!data/manifests/*.json

